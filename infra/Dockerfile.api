# API Dockerfile with Node 20 and oasdiff CLI
FROM node:20-bookworm-slim AS base

# Install curl, ca-certificates, and download oasdiff binary
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install oasdiff binary
ARG OASDIFF_VERSION=1.33.0
RUN TARGET_ARCH=$(dpkg --print-architecture) && \
    if [ "$TARGET_ARCH" = "amd64" ]; then ARCH_NAME="amd64"; else ARCH_NAME="arm64"; fi && \
    curl -fsSL "https://github.com/Tufin/oasdiff/releases/download/v${OASDIFF_VERSION}/oasdiff_${OASDIFF_VERSION}_linux_${ARCH_NAME}.tar.gz" -o oasdiff.tar.gz && \
    tar -xzf oasdiff.tar.gz -C /usr/local/bin oasdiff && \
    chmod +x /usr/local/bin/oasdiff && \
    rm oasdiff.tar.gz

WORKDIR /app

# Copy root configs and package manifests
COPY package.json package-lock.json* tsconfig.base.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/analyzer/package.json ./packages/analyzer/
COPY apps/api/package.json ./apps/api/

RUN npm install

# Copy source
COPY packages/shared ./packages/shared
COPY packages/analyzer ./packages/analyzer
COPY apps/api ./apps/api

# Build shared & analyzer packages
RUN npm run build -w packages/shared || true
RUN npm run build -w packages/analyzer || true
RUN npm run build -w apps/api || true

USER node
EXPOSE 4000

CMD ["npm", "run", "start", "-w", "apps/api"]
