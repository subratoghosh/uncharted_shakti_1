# Server Configuration
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=shaktiq

# Authentication & Security (Must be >= 32 characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
INTERNAL_API_KEY=super_secret_internal_key_at_least_32_chars_long
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_key

# n8n Orchestrator
N8N_WEBHOOK_URL=http://localhost:5678/webhook/shaktiq-analyze-run
N8N_WEBHOOK_TOKEN=shaktiq-secret-n8n-token

# Analyzer & Spec Limits
OASDIFF_MODE=binary
MAX_SPEC_BYTES=5242880

# Initial Admin User (Seeded by db/migrate.ts)
ADMIN_EMAIL=admin@shaktiq.dev
ADMIN_PASSWORD=admin1234!

# Optional Claude Integration
AI_EXPLANATIONS_ENABLED=false
