# ShaktIQ Environment Configuration Example
# Copy this file to .env before starting the services

# ==========================================
# API Configuration (apps/api)
# ==========================================
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/shaktiq
MONGODB_DB=shaktiq

# Security & Auth Secrets (Must be at least 32 characters in production)
JWT_SECRET=development-jwt-secret-key-minimum-32-characters-required
INTERNAL_API_KEY=development-internal-api-key-minimum-32-characters
GITHUB_WEBHOOK_SECRET=development-github-webhook-shared-secret

# Frontend Origin for CORS
WEB_ORIGIN=http://localhost:3000

# n8n Orchestrator Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/shaktiq-analyze-run
N8N_WEBHOOK_TOKEN=shaktiq-n8n-header-token-development

# Analyzer Configuration
OASDIFF_MODE=binary
MAX_SPEC_BYTES=5242880

# Seed Administrator
ADMIN_EMAIL=admin@shaktiq.dev
ADMIN_PASSWORD=AdminSecurePassword123!

# AI Features (Claude via n8n)
AI_EXPLANATIONS_ENABLED=false

# ==========================================
# n8n Configuration (infra/docker-compose.yml)
# ==========================================
N8N_ENCRYPTION_KEY=development-n8n-encryption-key-minimum-32-chars
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=AdminN8nPassword123!
SHAKTIQ_API_URL=http://api:4000
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# Credentials configured directly inside n8n credential store:
# - GITHUB_TOKEN (fine-grained PAT: Contents read, PR write)
# - ANTHROPIC_API_KEY (optional)

# ==========================================
# Web Configuration (apps/web)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# NextAuth & OAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=development-nextauth-secret-key-minimum-32-chars-long!

# Google OAuth (Obtain from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (Obtain from GitHub -> Settings -> Developer settings -> OAuth Apps)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

