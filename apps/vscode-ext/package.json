{
  "name": "shaktiq-vscode",
  "displayName": "shaktIQ – AI Code Audit & Contract Intelligence",
  "description": "Deterministic OpenAPI Breaking Change Detection & AI Code Audit, Remediation, and Fixes in VS Code",
  "version": "0.2.0",
  "publisher": "shaktIQ",
  "icon": "resources/icon.png",
  "license": "MIT",
  "homepage": "https://shaktiq.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/subratoghosh/uncharted_shakti_1.git"
  },
  "bugs": {
    "url": "https://github.com/subratoghosh/uncharted_shakti_1/issues"
  },
  "qna": "https://github.com/subratoghosh/uncharted_shakti_1/issues",
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "breaking-changes",
    "diff",
    "linter",
    "governance"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:shaktiq.signIn",
    "onCommand:shaktiq.analyze",
    "onCommand:shaktiq.reviewCode",
    "onCommand:shaktiq.suggestFix",
    "onCommand:shaktiq.applyFix",
    "onCommand:shaktiq.openDashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shaktiq.analyze",
        "title": "shaktIQ: Analyze API changes & Review Code",
        "icon": "$(zap)"
      },
      {
        "command": "shaktiq.reviewCode",
        "title": "shaktIQ: AI Review Active Code & Contract",
        "icon": "$(sparkle)"
      },
      {
        "command": "shaktiq.suggestFix",
        "title": "shaktIQ: Suggest & Apply AI Code Fix",
        "icon": "$(wrench)"
      },
      {
        "command": "shaktiq.openDashboard",
        "title": "shaktIQ: Open in Web Studio / Dashboard",
        "icon": "$(link-external)"
      },
      {
        "command": "shaktiq.signIn",
        "title": "shaktIQ: Sign in with token",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "shaktiq.analyze",
          "group": "navigation",
          "when": "resourceExtname =~ /\\.(yaml|yml|json|py|ts|js|go|java)$/"
        }
      ],
      "editor/context": [
        {
          "command": "shaktiq.reviewCode",
          "group": "shaktiq@1"
        },
        {
          "command": "shaktiq.suggestFix",
          "group": "shaktiq@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shaktiq-sidebar",
          "title": "shaktIQ",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "shaktiq-sidebar": [
        {
          "id": "shaktiq.findingsView",
          "name": "Breaking Changes & Code Issues"
        },
        {
          "id": "shaktiq.routesView",
          "name": "Detected API Endpoints"
        },
        {
          "id": "shaktiq.actionsView",
          "name": "AI Remediation & Fixes"
        }
      ]
    },
    "configuration": {
      "title": "shaktIQ",
      "properties": {
        "shaktiq.apiUrl": {
          "type": "string",
          "default": "https://uncharted-shakti-1.onrender.com/api/v1",
          "description": "shaktIQ API base URL (falls back to http://127.0.0.1:4000/api/v1 if offline)"
        },
        "shaktiq.webUrl": {
          "type": "string",
          "default": "https://shaktiq.vercel.app",
          "description": "shaktIQ Web Dashboard URL"
        },
        "shaktiq.specPath": {
          "type": "string",
          "default": "openapi.yaml",
          "description": "Default relative path to OpenAPI specification file (auto-detects if missing)"
        },
        "shaktiq.baseRef": {
          "type": "string",
          "default": "HEAD",
          "description": "Default Git reference to compare working copy against"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "package": "tsc && vsce package --no-dependencies --no-git-tag-version --skip-license"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
