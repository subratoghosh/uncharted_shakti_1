{
  "name": "shaktiq-vscode",
  "displayName": "shaktIQ – OpenAPI Breaking Change Detection",
  "description": "Deterministic OpenAPI Breaking Change Detection & Release Impact Intelligence in VS Code",
  "version": "0.1.0",
  "publisher": "shaktIQ",
  "icon": "resources/icon.png",
  "license": "MIT",
  "homepage": "https://shaktiq.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/subratoghosh/uncharted_shakti_1.git"
  },
  "bugs": {
    "url": "https://github.com/subratoghosh/uncharted_shakti_1/issues"
  },
  "qna": "https://github.com/subratoghosh/uncharted_shakti_1/issues",
  "keywords": [
    "openapi",
    "swagger",
    "api",
    "breaking-changes",
    "diff",
    "linter",
    "governance"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onCommand:shaktiq.signIn",
    "onCommand:shaktiq.analyze",
    "onCommand:shaktiq.openDashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "shaktiq.signIn",
        "title": "shaktIQ: Sign in with token"
      },
      {
        "command": "shaktiq.analyze",
        "title": "shaktIQ: Analyze API changes"
      },
      {
        "command": "shaktiq.openDashboard",
        "title": "shaktIQ: Open last run in dashboard"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "shaktiq-sidebar",
          "title": "shaktIQ",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "shaktiq-sidebar": [
        {
          "id": "shaktiq.findingsView",
          "name": "API Findings"
        }
      ]
    },
    "configuration": {
      "title": "shaktIQ",
      "properties": {
        "shaktiq.apiUrl": {
          "type": "string",
          "default": "https://uncharted-shakti-1.onrender.com/api/v1",
          "description": "shaktIQ API base URL"
        },
        "shaktiq.webUrl": {
          "type": "string",
          "default": "https://shaktiq.vercel.app",
          "description": "shaktIQ Web Dashboard URL"
        },
        "shaktiq.specPath": {
          "type": "string",
          "default": "openapi.yaml",
          "description": "Relative path to OpenAPI specification file"
        },
        "shaktiq.baseRef": {
          "type": "string",
          "default": "HEAD",
          "description": "Default Git reference to compare working copy against"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "package": "tsc && vsce package --no-dependencies --no-git-tag-version --skip-license"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
