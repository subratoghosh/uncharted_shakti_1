{
  "name": "@shaktiq/api",
  "version": "1.0.0",
  "description": "Fastify API backend for ShaktIQ",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@google/genai": "^2.32.0",
    "@shaktiq/analyzer": "*",
    "@shaktiq/shared": "*",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "fastify-raw-body": "^4.3.0",
    "fastify-type-provider-zod": "^2.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.12.0",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.7",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
