# ShaktIQ API Environment Configuration Example
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/shaktiq
MONGODB_DB=shaktiq
JWT_SECRET=development-jwt-secret-key-minimum-32-characters-required
INTERNAL_API_KEY=development-internal-api-key-minimum-32-characters
GITHUB_WEBHOOK_SECRET=development-github-webhook-shared-secret
WEB_ORIGIN=http://localhost:3000
N8N_WEBHOOK_URL=http://localhost:5678/webhook/shaktiq-analyze-run
N8N_WEBHOOK_TOKEN=shaktiq-n8n-header-token-development
OASDIFF_MODE=binary
MAX_SPEC_BYTES=5242880
ADMIN_EMAIL=admin@shaktiq.dev
ADMIN_PASSWORD=AdminSecurePassword123!
AI_EXPLANATIONS_ENABLED=false

# Google Gemini Multi-Layer AI Intelligence
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
