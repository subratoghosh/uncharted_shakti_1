{
  "name": "shaktiq",
  "version": "1.0.0",
  "private": true,
  "description": "Deterministic OpenAPI Breaking Change Detection & Release Impact Intelligence",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "n8n/stub-api"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "test": "npm test --workspaces --if-present",
    "test:ai": "npm run test:ai -w apps/api",
    "dev:mongo": "npx tsx scripts/start-local-mongo.ts",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "dev:n8n": "./scripts/start-n8n.sh"
  },
  "devDependencies": {
    "@next/swc-darwin-arm64": "^16.4.3",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0"
  }
}
