{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch ShaktIQ VS Code Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/apps/vscode-ext",
        "${workspaceFolder}"
      ],
      "outFiles": ["${workspaceFolder}/apps/vscode-ext/dist/**/*.js"],
      "preLaunchTask": "npm: build-ext"
    }
  ]
}
